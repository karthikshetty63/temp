# Copy this file to ".env" in the project root and fill in real values.
# Never commit .env — it is listed in .gitignore.

# ─── Server ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>
JWT_SECRET=<long random string, at least 32 characters>
PORT=5000
# Address of the React app. Used for CORS and for the links inside emails.
FRONTEND_ORIGIN=http://localhost:5173
# Only when running behind a reverse proxy (e.g. 1):
# TRUST_PROXY=1

# ─── Email (password reset links) ────────────────────────────────────────────
# Any SMTP provider works. For local testing, a free Ethereal account
# (https://ethereal.email) catches every email without delivering it.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
# "true" for port 465 (TLS from the start). Leave unset to decide from the port.
# SMTP_SECURE=false
SMTP_USER=<smtp username>
SMTP_PASS=<smtp password or app password>
EMAIL_FROM="VIDYADAAN <no-reply@example.com>"

# ─── Sign in with Google ─────────────────────────────────────────────────────
# OAuth Client ID (type "Web application") from Google Cloud Console. It is public,
# not a secret. The website and the server both read this one line. Leave it unset
# and the Google button stays hidden. Restart `npm run dev` after changing it.
# VITE_GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com

# ─── Donations (Razorpay, TEST MODE) ─────────────────────────────────────────
# Test keys only (they start with rzp_test_): Razorpay Dashboard → Test Mode →
# Account & Settings → API Keys → Generate Test Key. No real money moves in test mode.
# The server refuses live keys for now. The secret stays on the server: the website
# receives only the key ID, from the API. Leave both unset and donations stay off.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=<test key secret>

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# Where the React app sends API requests. Defaults to http://localhost:5000.
# VITE_API_BASE_URL=http://localhost:5000
